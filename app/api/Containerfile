# syntax=docker/dockerfile:1.7
# api service image. OCI-compatible: builds with Docker BuildKit and Apple's container CLI.
FROM python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641 AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.txt .
# Optional corporate/proxy CA as a BuildKit secret; never written to a layer.
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi; \
    pip install -r requirements.txt
COPY api ./api

FROM base AS test
COPY requirements-test.txt .
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi; \
    pip install -r requirements-test.txt
COPY tests ./tests
RUN python -m pytest -q

FROM base AS runtime
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER 10001
EXPOSE 5000
# Bound to loopback: only containers in the same task (shared awsvpc namespace) can reach it.
CMD ["gunicorn", "--bind", "127.0.0.1:5000", "--workers", "2", "--threads", "4", "--timeout", "120", "--graceful-timeout", "30", "api.wsgi:app"]
