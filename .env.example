# Seller release pipeline configuration (non-secret placeholders only).
# Used by `make synth-pipeline` for offline synthesis. Real deployments read these from the
# environment of the deploying shell or CI job; .env files are never loaded automatically.

# Source repository (GitHub via AWS CodeConnections)
GITHUB_OWNER=example-org
GITHUB_REPO=ghes-aws-cdk-ecs-deploy
GITHUB_BRANCH=main
CODECONNECTIONS_ARN=arn:aws:codeconnections:us-east-1:111122223333:connection/11111111-2222-3333-4444-555555555555

# Seller (pipeline) account
SELLER_ACCOUNT_ID=111122223333
SELLER_REGION=us-east-1

# Dedicated clean-account test account and the single role the pipeline may assume there
TEST_ACCOUNT_ID=444455556666
TEST_DEPLOY_ROLE_ARN=arn:aws:iam::444455556666:role/marketplace-clean-account-test
TEST_REGION=us-east-1
TEST_CERTIFICATE_ARN=arn:aws:acm:us-east-1:444455556666:certificate/11111111-2222-3333-4444-555555555555
TEST_APP_DOMAIN=test.internal.example.com
TEST_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# AWS Marketplace product and delivery option (from your existing ContainerProduct listing)
MARKETPLACE_PRODUCT_ID=prod-exampleexample1
MARKETPLACE_CATALOG_REGION=us-east-1
MARKETPLACE_DELIVERY_OPTION_TITLE="CloudFormation on Amazon ECS (private VPC)"
MARKETPLACE_ECR_REPOSITORIES=frontend=709825985650.dkr.ecr.us-east-1.amazonaws.com/example-seller/private-app-frontend,api=709825985650.dkr.ecr.us-east-1.amazonaws.com/example-seller/private-app-api,agent=709825985650.dkr.ecr.us-east-1.amazonaws.com/example-seller/private-app-agent
# Release state the verification stage must prove before announcing: Public, Limited or Restricted
MARKETPLACE_REQUIRED_VISIBILITY=Public
MARKETPLACE_WAIT_MAX_MINUTES=240
# Optional public listing URL included in announcements (otherwise customers get instructions by product ID)
MARKETPLACE_LISTING_URL=

# Where buyers download the versioned CloudFormation template (seller-owned bucket + public URL base)
TEMPLATE_PUBLISH_BUCKET=example-seller-marketplace-templates
TEMPLATE_PUBLIC_BASE_URL=https://example-seller-marketplace-templates.s3.us-east-1.amazonaws.com

# Notifications
RELEASE_TOPIC_ARN=arn:aws:sns:us-east-1:111122223333:marketplace-release-announcements
APPROVER_EMAILS=release-approver@example.com

# Supported product versions customers may upgrade from (clean-account upgrade tests cover each)
SUPPORTED_UPGRADE_FROM=
